    "## build the tables with respective transformations and correct order"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "inputWidgets": {},
     "nuid": "0c7bc209-819c-44ce-ade4-dd3d85ef3aeb",
     "showTitle": false,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [],
   "source": [
    "process('category_translation', 'category_translation', ['product_category_name'],\n",
    "        lambda d: d)\n",
    "\n",
    "process('customers', 'customers', ['customer_id'],\n",
    "        lambda d: d.withColumn('customer_city', F.initcap('customer_city'))\n",
    "                   .withColumn('customer_state', F.upper('customer_state')))\n",
    "\n",
    "process('sellers', 'sellers', ['seller_id'],\n",
    "        lambda d: d.withColumn('seller_city', F.initcap('seller_city'))\n",
    "                   .withColumn('seller_state', F.upper('seller_state')))\n",
    "\n",
    "process('orders', 'orders', ['order_id'],\n",
    "        lambda d: d.withColumn('order_purchase_timestamp', F.to_timestamp('order_purchase_timestamp'))\n",
    "                   .withColumn('order_approved_at', F.to_timestamp('order_approved_at'))\n",
    "                   .withColumn('order_delivered_carrier_date', F.to_timestamp('order_delivered_carrier_date'))\n",
    "                   .withColumn('order_delivered_customer_date', F.to_timestamp('order_delivered_customer_date'))\n",
    "                   .withColumn('order_estimated_delivery_date', F.to_timestamp('order_estimated_delivery_date')),\n",
    "        rule='customer_id IS NOT NULL')\n",
    "\n",
    "process('order_items', 'order_items', ['order_id', 'order_item_id'],\n",
    "        lambda d: d.withColumn('order_item_id', F.col('order_item_id').cast('int'))\n",
    "                   .withColumn('shipping_limit_date', F.to_timestamp('shipping_limit_date'))\n",
    "                   .withColumn('price', F.col('price').cast('decimal(10,2)'))\n",
    "                   .withColumn('freight_value', F.col('freight_value').cast('decimal(10,2)')),\n",
    "        rule='price >= 0 AND freight_value >= 0')\n",
    "\n",
    "process('payments', 'payments', ['order_id', 'payment_sequential'],\n",
    "        lambda d: d.withColumn('payment_sequential', F.col('payment_sequential').cast('int'))\n",
    "                   .withColumn('payment_installments', F.col('payment_installments').cast('int'))\n",
    "                   .withColumn('payment_value', F.col('payment_value').cast('decimal(10,2)')),\n",
    "        rule='payment_value >= 0')\n",
    "\n",
    "process('reviews', 'reviews', ['review_id', 'order_id'],\n",
    "        lambda d: d.withColumn('review_score', F.col('review_score').cast('int'))\n",
    "                   .withColumn('review_creation_date', F.to_timestamp('review_creation_date'))\n",
    "                   .withColumn('review_answer_timestamp', F.to_timestamp('review_answer_timestamp')),\n",
    "        rule='review_score BETWEEN 1 AND 5')\n",
    "\n",
    "# products joins the translation table, so it must run after category_translation\n",
    "tr = spark.table(f'{catalog}.silver.category_translation').select(\n",
    "    'product_category_name', 'product_category_name_english')\n",
    "\n",
    "def products_tf(d):\n",
    "    d = (d.withColumnRenamed('product_name_lenght', 'product_name_length')\n",
    "          .withColumnRenamed('product_description_lenght', 'product_description_length'))\n",
    "    for c in ['product_name_length', 'product_description_length', 'product_photos_qty']:\n",
    "        d = d.withColumn(c, F.col(c).cast('int'))\n",
    "    for c in ['product_weight_g', 'product_length_cm', 'product_height_cm', 'product_width_cm']:\n",
    "        d = d.withColumn(c, F.col(c).cast('double'))\n",
    "    return (d.join(tr, 'product_category_name', 'left')\n",
    "             .withColumn('product_category_english',\n",
    "                         F.coalesce('product_category_name_english', 'product_category_name', F.lit('unknown')))\n",
    "             .drop('product_category_name_english'))\n",
    "\n",
    "process('products', 'products', ['product_id'], products_tf,\n",
    "        rule='product_weight_g IS NULL OR product_weight_g >= 0')"
   ]
  },
