   "source": [
    "keys = {'orders':['order_id'], 'order_items':['order_id','order_item_id'],\n",
    "        'payments':['order_id','payment_sequential'], 'reviews':['review_id','order_id'],\n",
    "        'customers':['customer_id'], 'products':['product_id'],\n",
    "        'sellers':['seller_id'], 'category_translation':['product_category_name']}\n",
    "for t, k in keys.items():\n",
    "    df = spark.table(f'{catalog}.silver.{t}')\n",
    "    dupes = df.count() - df.dropDuplicates(k).count()\n",
    "    print(f'{t}: dupes={dupes}', 'OK' if dupes == 0 else 'PROBLEM')"
   ]
  }
