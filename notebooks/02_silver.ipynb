   "source": [
    "from pyspark.sql import functions as F\n",
    "from pyspark.sql.window import Window\n",
    "from pyspark.sql.types import StringType\n",
    "from delta.tables import DeltaTable\n",
    "\n",
    "catalog = 'olist'\n",
    "\n",
    "def trim_all(df):\n",
    "    # trim every text column and turn empty strings into nulls\n",
    "    return df.select([\n",
    "        F.when(F.trim(F.col(c)) == '', None).otherwise(F.trim(F.col(c))).alias(c)\n",
    "        if isinstance(f.dataType, StringType) else F.col(c)\n",
    "        for c, f in zip(df.columns, df.schema.fields)\n",
    "    ])\n",
    "\n",
    "def dedup(df, keys):\n",
    "    # keep the latest loaded row for each key\n",
    "    w = Window.partitionBy(*keys).orderBy(F.col('_ingested_at').desc())\n",
    "    return df.withColumn('_rn', F.row_number().over(w)).filter('_rn = 1').drop('_rn')\n",
    "\n",
    "def upsert(df, name, keys):\n",
    "    cond = ' AND '.join([f't.{k} = s.{k}' for k in keys])\n",
    "    if not spark.catalog.tableExists(name):\n",
    "        df.write.saveAsTable(name)\n",
    "    else:\n",
    "        (DeltaTable.forName(spark, name).alias('t')\n",
    "           .merge(df.alias('s'), cond)\n",
    "           .whenMatchedUpdateAll().whenNotMatchedInsertAll().execute())\n",
    "\n",
    "def process(src, tgt, keys, transform, rule='true'):\n",
    "    raw = trim_all(spark.table(f'{catalog}.bronze.{src}'))\n",
    "    typed = transform(raw)\n",
    "    key_ok = ' AND '.join([f'{k} IS NOT NULL' for k in keys])\n",
    "    ok = F.expr(f'coalesce(({key_ok}) AND ({rule}), false)')\n",
    "    good = dedup(typed.filter(ok), keys)\n",
    "    bad = typed.filter(~ok).withColumn('_dq_reason', F.lit(f'null key or failed rule: {rule}'))\n",
    "    upsert(good, f'{catalog}.silver.{tgt}', keys)\n",
    "    bad.write.mode('overwrite').saveAsTable(f'{catalog}.silver.{tgt}_quarantine')\n",
    "    print(f'{tgt}: bronze={raw.count()} good={good.count()} quarantined={bad.count()}')"
   ]
  },
